# Copy to frontend/.env and fill in real values. Never commit the filled-in file.
#
# WARNING: Vite inlines every VITE_* variable into the client bundle at build
# time. Anything here is readable by anyone who loads the page, so it must
# never hold a value you would treat as a server-side secret.

# Base URL of the admin backend.
VITE_API_URL=http://localhost:8001

# Admin key sent by the panel; must match ADMIN_API_KEY in backend/.env.
VITE_ADMIN_KEY=
