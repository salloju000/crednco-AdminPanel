# Copy to backend/.env and fill in real values. Never commit the filled-in file.

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=development
PORT=8001
LOG_LEVEL=INFO

# Comma-separated CORS origins. Vite uses 5174/5175 when 5173 is taken.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ── Secrets ───────────────────────────────────────────────────────────────────
# Required outside ENV=development — the backend refuses to start without them.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_API_KEY=

# ── Firebase (Firestore access) ───────────────────────────────────────────────
# Supply ONE of the following three options.
#
# 1. Path to a service account JSON file (simplest for local development):
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
#
# 2. The entire service account JSON inline (useful for hosted deployments):
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# 3. The individual fields:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Development-only login ────────────────────────────────────────────────────
# Accepts a hardcoded admin/admin123 login that skips TOTP. Only honoured when
# ENV=development. Never enable this on a deployed environment.
ALLOW_DEFAULT_ADMIN=false
